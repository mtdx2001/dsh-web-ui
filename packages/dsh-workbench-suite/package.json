  "type": "module",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/aggregate.mjs --check",
    "prepare": "node ../../scripts/aggregate.mjs --check"
  },
  "license": "Apache-2.0",
  "files": [
