    "directory": "packages/dsh-workbench-suite"
  },
  "dependencies": {
    "@mtdx2001/dsh-client-ui-workbench": "workspace:*",
    "@mtdx2001/dsh-client-ui-balance-rows": "workspace:*",
    "@linxin666/dsh-client-ui-aionui-panel": "0.1.19",
    "@linxin666/dsh-client-ui-task-board": "0.1.19",
    "@linxin666/dsh-ssh": "0.1.19"
  }
